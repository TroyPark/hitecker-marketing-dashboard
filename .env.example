# 복사해서 .env 로 쓰세요. .env 는 .gitignore 에 들어 있습니다.
# Supabase > Project Settings > API 에서 확인합니다.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon (public) 키 — 브라우저에 노출되는 값. RLS 로 보호됩니다.
SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role 키 — RLS를 우회합니다. 초기 마이그레이션 스크립트에서만 쓰고
# 절대 커밋하거나 프론트엔드에 넣지 마세요.
SUPABASE_SERVICE_KEY=eyJhbGciOi...
